local function hasAmmo()
    local wd = getCurrentWeaponData()
    if not wd or not wd.SlotData then return false end
    local sd = wd.SlotData
    local a = (sd.Ammo or 0) + (sd.LeftAmmo or 0) + (sd.RightAmmo or 0) + (sd.TotalAmmo or 0)
    return a > 0
end

local function consumeLocalAmmo(n)
    if not (SharedMemory and SharedMemory.CurrentWeaponData) then return end
    local wd = SharedMemory.CurrentWeaponData
    local sd = wd.SlotData
    if not sd then return end
    n = math.max(n or 1, 1)
    local function drain(field)
        if sd[field] ~= nil then
            local cur = sd[field]
            local take = math.min(cur, n)
            sd[field] = cur - take
            n = n - take
        end
    end
    drain("Ammo")
    if n > 0 then drain("LeftAmmo") end
    if n > 0 then drain("RightAmmo") end
    if n > 0 then drain("TotalAmmo") end
    local wm = getWeaponManager()
    if wm and wm.UpdateAmmoUI then
        pcall(function() wm:UpdateAmmoUI(sd) end)
    end
end

local function buildNewProjectile(wd, head, bulletID, shootingID)
    local sd = wd.SlotData or {}
    local barrel
    pcall(function()
        barrel = wd.Weapon and wd.Weapon:FindFirstChild("ReferenceObjects") and wd.Weapon.ReferenceObjects:FindFirstChild("FirePart")
    end)
    return {
        ZombiePenetration = 999,
        Origin = Camera,
        WeaponName = wd.WeaponName,
        PackLevel = sd.PackLevel or 0,
        BulletID = bulletID,
        Attachments = sd.Attachments or {
            Muzzle="None", Optic="None", Stock="None",
