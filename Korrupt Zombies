local function attachFOVEnforce(cam)
    if not cam then return end
    cam:GetPropertyChangedSignal("FieldOfView"):Connect(function()
        if Flags.HighFOV and math.abs(cam.FieldOfView - Flags.FOVValue) > 0.01 then
            pcall(function() cam.FieldOfView = Flags.FOVValue end)
        end
    end)
end
attachFOVEnforce(Camera)
Workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(function()
    Camera = Workspace.CurrentCamera
    attachFOVEnforce(Camera)
end)

local FOV_BIND_NAME = "KorruptCustomFOV"
pcall(function() RunService:UnbindFromRenderStep(FOV_BIND_NAME) end)
RunService:BindToRenderStep(FOV_BIND_NAME, Enum.RenderPriority.Last.Value, function()
    if Flags.HighFOV and Camera then
        local cur = Camera.FieldOfView
        if math.abs(cur - Flags.FOVValue) > 0.01 then
            pcall(function() Camera.FieldOfView = Flags.FOVValue end)
        end
    end
end)

