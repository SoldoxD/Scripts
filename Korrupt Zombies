local function isAlive(zombie)
    if not zombie or not zombie.Parent then return false end
    local hum = zombie:FindFirstChildOfClass("Humanoid")
    if hum and hum.Health <= 0 then return false end
    return zombie:FindFirstChild("HumanoidRootPart") ~= nil
end

local function getZombies()
    local list = {}
    local zfolder = Workspace:FindFirstChild("Zombies")
    if zfolder then
        for _, z in ipairs(zfolder:GetChildren()) do
            if isAlive(z) then table.insert(list, z) end
        end
    end

    for _, obj in ipairs(getnilinstances()) do
        if obj.Name == "Zombie" and isAlive(obj) then
            table.insert(list, obj)
        end
    end
    return list
end

local function getZombieHead(zombie)
    return zombie:FindFirstChild("Head")
        or zombie:FindFirstChild("UpperTorso")
        or zombie:FindFirstChild("HumanoidRootPart")
end

local function getZombiePart(zombie, partName)
    return zombie:FindFirstChild(partName) or getZombieHead(zombie)
end

local function isVisible(part)
    if not part then return false end
    local origin = Camera.CFrame.Position
    local dir = (part.Position - origin)
    local rayParams = RaycastParams.new()
    rayParams.FilterType = Enum.RaycastFilterType.Exclude
    rayParams.FilterDescendantsInstances = {
        Camera, getCharacter(), Workspace:FindFirstChild("Players"),
        Workspace:FindFirstChild("DebugRays"), Workspace:FindFirstChild("Ignore"),
        Workspace:FindFirstChild("Downed")
    }
    local result = Workspace:Raycast(origin, dir, rayParams)
    if not result then return true end
    if result.Instance:IsDescendantOf(part.Parent) then return true end
    return false
end

local function getSilentAimTarget()
    local closestDist = math.huge
    local bestPart = nil
    local viewSize = Camera.ViewportSize
    local center = Vector2.new(viewSize.X/2, viewSize.Y/2)

    for _, zombie in ipairs(getZombies()) do
        local part = getZombiePart(zombie, Flags.SilentPart)
        if part then
            local screen, onScreen = Camera:WorldToViewportPoint(part.Position)
            if onScreen then
                local dist = (Vector2.new(screen.X, screen.Y) - center).Magnitude
                local fovOk = dist <= Flags.SilentFOV
                local visOk = (not Flags.VisibleCheck) or isVisible(part)
                if fovOk and visOk and dist < closestDist then
                    closestDist = dist
                    bestPart = part
                end
            end
        end
    end
    return bestPart
end

local function predictPart(part)
    if not part then return nil end
    local ok, vel = pcall(function() return part.AssemblyLinearVelocity end)
    if not ok or not vel then vel = Vector3.zero end
    return part.Position + vel * Flags.AimbotPrediction
end

local function pickAimbotPart(zombie)

    local order = {Flags.AimbotPart, "Head", "UpperTorso", "Torso", "LowerTorso", "HumanoidRootPart"}
    local seen = {}
    for _, n in ipairs(order) do
        if not seen[n] then
            seen[n] = true
            local p = zombie:FindFirstChild(n)
            if p then return p end
        end
    end
    return nil
end

local function getAimbotTarget()
    local mp = UserInputService:GetMouseLocation()
    local camPos = Camera.CFrame.Position
    local bestPart, bestDist = nil, math.huge
    for _, zombie in ipairs(getZombies()) do
        local hrp = zombie:FindFirstChild("HumanoidRootPart")
        if hrp and (hrp.Position - camPos).Magnitude <= Flags.AimbotDistance then
            local part = pickAimbotPart(zombie)
            if part then
                local visOk = (not Flags.AimbotVisCheck) or isVisible(part)
                if visOk then
                    local pred = predictPart(part)
                    local sp, on = Camera:WorldToViewportPoint(pred)
                    if on then
                        local dx, dy = sp.X - mp.X, sp.Y - mp.Y
                        local d = math.sqrt(dx*dx + dy*dy)
                        if d <= Flags.AimbotFOV and d < bestDist then
                            bestPart, bestDist = part, d
                        end
                    end
                end
            end
        end
    end
    return bestPart
end

