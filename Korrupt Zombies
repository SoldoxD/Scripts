local function autoCompleteWeaponUpgrader()
    if teleBusy then return false, "already running" end
    teleBusy = true
    local function finish(ok, msg, kind)
        teleBusy = false
        GuiLibrary:CreateNotification("Auto Upgrader", msg, 3, kind or (ok and "success" or "error"))
        return ok, msg
    end

    local tele = getTeleporter()
    if not tele then return finish(false, "no Teleporter (wrong map?)", "error") end
    if tele:GetAttribute("Active") then
        return finish(true, "upgrader already active", "info")
    end

    if getCollectedCount("Teleporter Part") < 1 then
        for _ = 1, 3 do
            if getCollectedCount("Teleporter Part") >= 1 then break end
            pickupEasterEggPart("Teleporter Part")
            task.wait(0.2)
        end
    end
    if getCollectedCount("Teleporter Part") < 1 then
        return finish(false, "couldn't pick up Teleporter Part", "error")
    end

    local root = getRoot()
    local homeCF = root and root.CFrame
    local part = tele:FindFirstChild("Interaction") or tele:FindFirstChildWhichIsA("BasePart", true)
    if root and part then
        pcall(function() root.CFrame = part.CFrame + Vector3.new(0, 3, 0) end)
        task.wait(0.1)
    end
    for _ = 1, 5 do
        if tele:GetAttribute("Active") then break end
        pcall(function() Remote:FireServer("Place Nacht Teleporter Part", tele) end)
        task.wait(0.25)
    end
    if root and homeCF then
        pcall(function() root.CFrame = homeCF end)
    end

    return finish(tele:GetAttribute("Active") == true,
        tele:GetAttribute("Active") and "upgrader activated" or "place failed",
        tele:GetAttribute("Active") and "success" or "warning")
end

local flyBV, flyBG
local function destroyFly()
    if flyBV then flyBV:Destroy(); flyBV = nil end
    if flyBG then flyBG:Destroy(); flyBG = nil end
end

local function updateFly()
    if not Flags.Fly then destroyFly(); return end
    local root = getRoot()
    local hum = getHumanoid()
    if not root or not hum then destroyFly(); return end

    if not flyBV then
        flyBV = Instance.new("BodyVelocity")
        flyBV.MaxForce = Vector3.new(1e9, 1e9, 1e9)
        flyBV.Velocity = Vector3.zero
        flyBV.Parent = root
    end
    if not flyBG then
        flyBG = Instance.new("BodyGyro")
        flyBG.MaxTorque = Vector3.new(1e9, 1e9, 1e9)
        flyBG.D = 100
        flyBG.P = 1e4
        flyBG.Parent = root
    end

    flyBG.CFrame = Camera.CFrame

    local dir = Vector3.zero
    if UserInputService:IsKeyDown(Enum.KeyCode.W) then dir = dir + Camera.CFrame.LookVector end
    if UserInputService:IsKeyDown(Enum.KeyCode.S) then dir = dir - Camera.CFrame.LookVector end
    if UserInputService:IsKeyDown(Enum.KeyCode.A) then dir = dir - Camera.CFrame.RightVector end
    if UserInputService:IsKeyDown(Enum.KeyCode.D) then dir = dir + Camera.CFrame.RightVector end
    if UserInputService:IsKeyDown(Enum.KeyCode.Space) then dir = dir + Vector3.new(0,1,0) end
    if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then dir = dir - Vector3.new(0,1,0) end

    if dir.Magnitude > 0 then dir = dir.Unit * Flags.FlySpeed end
    flyBV.Velocity = dir
end

local function applyPlayerMods()
    local hum = getHumanoid()
    if hum then
        if hum.WalkSpeed ~= Flags.WalkSpeed then
            pcall(function() hum.WalkSpeed = Flags.WalkSpeed end)
        end
        if hum.JumpPower ~= Flags.JumpPower then
            pcall(function() hum.JumpPower = Flags.JumpPower end)
            pcall(function() hum.JumpHeight = Flags.JumpPower / 3 end)
        end
    end

    if Flags.NoClip then
        local c = getCharacter()
        if c then
            for _, p in ipairs(c:GetDescendants()) do
                if p:IsA("BasePart") then p.CanCollide = false end
            end
        end
    end
end

