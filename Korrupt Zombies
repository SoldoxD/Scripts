local function repairOneBarricade(barricade)
    local stage = barricade:FindFirstChild("Stage")
    local total = barricade:FindFirstChild("TotalPlanks")
    if not (stage and total) then return 0 end

    local root = getRoot()
    if not root then return 0 end
    local home = root.CFrame

    local part = barricade:FindFirstChild("Origin")
        or barricade.PrimaryPart
        or barricade:FindFirstChildWhichIsA("BasePart", true)
    if not part or not part:IsA("BasePart") then return 0 end

    pcall(function() root.CFrame = part.CFrame + Vector3.new(0, 3, 0) end)
    task.wait(0.25)

    local planks = 0
    local safety = 0
    while stage.Value <= total.Value and safety < 20 do
        safety = safety + 1

        local waitT = tick()
        while barricade:GetAttribute("CannotRepair") and tick() - waitT < 1.5 do
            task.wait(0.1)
        end

        pcall(function() root.CFrame = part.CFrame + Vector3.new(0, 3, 0) end)
        local before = stage.Value
        pcall(function() Remote:FireServer("Repair Barricade", barricade) end)

        task.wait(0.4)
        if stage.Value > before then
            planks = planks + 1
        end
    end

    pcall(function() root.CFrame = home end)
    return planks
end

local function repairAllBarricades()
    local gs = getGameStats()
    if gs and gs:FindFirstChild("Paused") and gs.Paused.Value then
