local PACK_COSTS = { 5000, 15000, 30000 }

local packBusy = false
local function autoPackAPunch()
    if packBusy then return false, "already running" end
    packBusy = true
    local function finish(ok, msg, kind)
        packBusy = false
        GuiLibrary:CreateNotification("Pack-A-Punch", msg, 3, kind or (ok and "success" or "error"))
        return ok, msg
    end

    if not isPowerOn() then return finish(false, "power is off", "warning") end
    local canPack, why = canPackCurrentWeapon()
    if not canPack then return finish(false, why, "warning") end

    local box = getPackAPunchBox()
    if not box then return finish(false, "no PAP box found", "error") end

    local inUse = box:GetAttribute("InUse")
    if inUse and inUse ~= LocalPlayer.UserId then
        return finish(false, "PAP busy with another player", "warning")
    end
    if box:GetAttribute("Disabled") then
        return finish(false, "PAP on cooldown", "warning")
    end

    local wd = getCurrentWeaponData()
    local sd = wd and wd.SlotData
    local lvl = (sd and sd.PackLevel) or 0
    local cost = PACK_COSTS[lvl + 1] or 5000
    if box:GetAttribute("BonfireSale") then cost = math.floor(cost / 5) end
    local points = 0
    pcall(function() points = LocalPlayer.PlayerStats.Points.Value end)
    if points < cost then
        return finish(false, ("need %d points, have %d"):format(cost, points), "warning")
    end

    local root = getRoot()
    if not root then return finish(false, "no character", "error") end
    local home = root.CFrame
    local boxPart = box:FindFirstChild("Interaction")
        or box:FindFirstChild("Default")
        or box:FindFirstChildWhichIsA("BasePart", true)
    if not boxPart or not boxPart:IsA("BasePart") then
        return finish(false, "no PAP part to TP to", "error")
    end

    local function tpToBox()
        pcall(function() root.CFrame = boxPart.CFrame + Vector3.new(0, 3, 0) end)
    end

    if inUse == LocalPlayer.UserId and box:GetAttribute("Weapon") then
        tpToBox(); task.wait(0.3)
        pcall(function() Remote:FireServer("Take Packed Weapon", box) end)
        task.wait(0.5)
        pcall(function() root.CFrame = home end)
        return finish(true, "took: " .. tostring(box:GetAttribute("Weapon")), "success")
    end

    tpToBox()
    task.wait(0.3)
    GuiLibrary:CreateNotification("Pack-A-Punch",
        ("Inserting %s (cost %d)..."):format(sd.Weapon or "?", cost), 2, "info")
    pcall(function() Remote:FireServer("Pack A Punch Weapon", box) end)

    local startT = tick()
    local lastTp = tick()
    while tick() - startT < 25 do
        if tick() - lastTp > 1.0 then
            tpToBox()
            lastTp = tick()
        end
        task.wait(0.3)
        if box:GetAttribute("InUse") == LocalPlayer.UserId and box:GetAttribute("Weapon") then

            task.wait(0.4)
            tpToBox()
            task.wait(0.3)
            pcall(function() Remote:FireServer("Take Packed Weapon", box) end)
            task.wait(0.6)
            local got = tostring(box:GetAttribute("Weapon") or sd.Weapon or "?")
            pcall(function() root.CFrame = home end)
            return finish(true, "took: " .. got, "success")
        end
    end

    pcall(function() root.CFrame = home end)
    return finish(false, "timed out waiting for upgrade", "warning")
end

