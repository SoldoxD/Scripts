local CachedSilent = nil
local CachedAimbot = nil

local function refreshCaches()

    local p = getSilentAimTarget()
    if p and p.Parent then
        local zombie = p.Parent
        local head = getZombiePart(zombie, "Head") or p
        local origin = Camera.CFrame.Position
        CachedSilent = {
            part   = p,
            zombie = zombie,
            head   = head,
            pos    = p.Position,
            lookV  = (p.Position - origin).Unit,
        }
    else
        CachedSilent = nil
    end

    CachedAimbot = getAimbotTarget()
end

local function rewriteZombieHit(hitData, info_HitPart)
    if type(hitData) ~= "table" then return end
    local zh = hitData.ZombiesHit
    if type(zh) ~= "table" or #zh < 3 then return end
    for i = 1, #zh, 3 do
        local zombie = zh[i]
        local info   = zh[i + 2]
        if typeof(zombie) == "Instance" then
            local head = zombie.Head
            if head then
                zh[i + 1] = head
                if type(info) == "table" then
                    info.HitPart = info_HitPart or "Head"
                end
            end
        end
    end
    hitData.Headshot = true
end

local function processOutgoing(action, args)
    if action == "NewProjectiles" and Flags.SilentAim
       and math.random(1, 100) <= Flags.HitChance then
        local t = CachedSilent
        if t then
            local projectiles = args[2]
            if type(projectiles) == "table" then
                for i = 1, #projectiles do
                    local proj = projectiles[i]
                    if type(proj) == "table" then
                        proj.HitPosition = t.pos
                    end
                end
            end
        end
    end

    if action == "ProjectileHit" then
        local hitData = args[3]
        if type(hitData) == "table" then
            if Flags.SilentAim and math.random(1, 100) <= Flags.HitChance then
                local t = CachedSilent
                if t then
                                        hitData.HitWall = nil
                    hitData.Headshot = (Flags.SilentPart == "Head")
                    hitData.ZombiesHit = {
                        t.zombie, t.head,
                        {
                            HitPart       = Flags.SilentPart,
                            FleshHitIndex = math.random(1, 4),
                            HitOffset     = CFrame.new(),
                            HitLookVector = t.lookV,
                        }
                    }
                end
            end

            if Flags.OneShotKill then
                rewriteZombieHit(hitData, "Head")
                            end
        end
    end
end

