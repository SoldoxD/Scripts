    if Modules and Modules.WeaponInfo then
        local set = {}
        for n, info in pairs(Modules.WeaponInfo) do
            if type(info) == "table" and info.WeaponType == "Gun" and not set[n] then
                set[n] = true
                table.insert(names, n)
