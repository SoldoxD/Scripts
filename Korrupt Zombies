local powerBusy = false
local function autoCompletePower()
    if powerBusy then return false, "already running" end
    powerBusy = true
    local function finish(ok, msg, kind)
        powerBusy = false
        GuiLibrary:CreateNotification("Auto Power", msg, 3, kind or (ok and "success" or "error"))
        return ok, msg
    end

    if getMapFolder() and getGameStats() and getGameStats().Map and getGameStats().Map.Value ~= "Nacht Der Untoten" then
        return finish(false, "not on Nacht Der Untoten", "warning")
    end
    if isPowerOn() then
        return finish(true, "power already on", "info")
    end
    local box = getNachtPowerBox()
    if not box then return finish(false, "no NachtPowerBox", "error") end

    for _ = 1, 8 do
        if getCollectedCount("Power Cell") >= 3 then break end
        local ok = pickupEasterEggPart("Power Cell")
        if not ok then task.wait(0.5) end
    end
    GuiLibrary:CreateNotification("Auto Power",
        "Cells: " .. getCollectedCount("Power Cell") .. "/3", 2, "info")

    for _ = 1, 3 do
        if getCollectedCount("Power Handle") >= 1 then break end
        pickupEasterEggPart("Power Handle")
        task.wait(0.2)
    end
    GuiLibrary:CreateNotification("Auto Power",
        "Handles: " .. getCollectedCount("Power Handle") .. "/1", 2, "info")

    local root = getRoot()
    local homeCF = root and root.CFrame
    local part = box:FindFirstChild("Interaction") or box:FindFirstChildWhichIsA("BasePart", true)
    if root and part then
        pcall(function() root.CFrame = part.CFrame + Vector3.new(0, 3, 0) end)
        task.wait(0.1)
    end
    for _ = 1, 8 do
        local cellsIn  = box:GetAttribute("PowerCell")   or 0
        local handleIn = box:GetAttribute("PowerHandle") or 0
        local cellsHave  = getCollectedCount("Power Cell")
        local handleHave = getCollectedCount("Power Handle")
        if cellsIn >= cellsHave and handleIn >= handleHave then break end
        pcall(function() Remote:FireServer("Place Nacht Power Box Part", box) end)
        task.wait(0.25)
    end
    if root and homeCF then
        pcall(function() root.CFrame = homeCF end)
    end

    local cellsIn  = box:GetAttribute("PowerCell")   or 0
    local handleIn = box:GetAttribute("PowerHandle") or 0
    return finish(true,
        ("placed %d/3 cells, %d/1 handle"):format(cellsIn, handleIn),
        (cellsIn >= 3 and handleIn >= 1) and "success" or "warning")
end

