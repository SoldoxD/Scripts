local function autoMysteryBoxTick()
    if not Flags.AutoMysteryBox or mysteryBoxBusy then return end
    local box = getActiveMysteryBox()
    if not box then
        if not mysteryBoxNoBoxWarned then
            mbNotify("Mystery Box", "No active box found — waiting...", 2, "warning")
            mysteryBoxNoBoxWarned = true
        end
        return
    end
    mysteryBoxNoBoxWarned = false

    if box:GetAttribute("BeingUsed") then
        if box:GetAttribute("BeingUsed") == LocalPlayer.UserId then
            local w = box:GetAttribute("Weapon")
            if w and (Flags.DesiredWeapon == "Any" or w == Flags.DesiredWeapon) then
                mbNotify("Mystery Box", "Taking weapon: " .. w, 2, "success")
                pcall(function()
                    Remote:FireServer("Take Mystery Box Weapon", box)
                end)
            end
        end
        return
    end

    mysteryBoxBusy = true
    task.spawn(function()
        mbNotify("Mystery Box", "Buying box (target: " .. Flags.DesiredWeapon .. ")", 2, "info")
        local ok = pcall(function()
            Remote:FireServer("Buy Mystery Box", box)
        end)
        if not ok then
            mbNotify("Mystery Box", "Buy failed — out of points?", 2, "error")
            mysteryBoxBusy = false
            return
        end

        local startT = tick()
        local landed = false
        while tick() - startT < 12 do
            task.wait(0.1)
            local w = box:GetAttribute("Weapon")
            if w and box:GetAttribute("BeingUsed") == LocalPlayer.UserId then
                if Flags.DesiredWeapon == "Any" or w == Flags.DesiredWeapon then
                    mbNotify("Mystery Box", "Landed: " .. w .. " — taking it", 2, "success")
                    pcall(function()
                        Remote:FireServer("Take Mystery Box Weapon", box)
                    end)
                    landed = true
                    break
                else
                    mbNotify("Mystery Box", "Got " .. w .. " — skipping (want " .. Flags.DesiredWeapon .. ")", 2, "warning")
                    while box:GetAttribute("BeingUsed") and tick() - startT < 12 do
                        task.wait(0.25)
                    end
                    landed = true
                    break
                end
            end
        end
        if not landed then
            mbNotify("Mystery Box", "Timed out — retrying next tick", 2, "warning")
        end
        mysteryBoxBusy = false
    end)
end

