local function updateESP()

    for zombie, _ in pairs(espObjects) do
        if not isAlive(zombie) then
            removeESP(zombie)
        end
    end

    if not Flags.ESP then
        for zombie, _ in pairs(espObjects) do removeESP(zombie) end
        return
    end

    local zombies = getZombies()
    for _, zombie in ipairs(zombies) do
        if not espObjects[zombie] then
            createESP(zombie)
        end
    end

    for zombie, objs in pairs(espObjects) do
        local root = zombie:FindFirstChild("HumanoidRootPart")
        local hum  = zombie:FindFirstChildOfClass("Humanoid")
        if root and hum then
            local dist = (Camera.CFrame.Position - root.Position).Magnitude

            local show = dist <= Flags.ESPMaxDistance

            objs.NameLbl.Visible = show and Flags.ESPName
            objs.NameLbl.TextColor3 = Flags.ESPColor

            if show and Flags.ESPHealth then
                objs.HealthLbl.Visible = true
                objs.HealthLbl.Text = ("HP: %d / %d"):format(math.floor(hum.Health), math.floor(hum.MaxHealth))

                local pct = math.clamp(hum.Health / math.max(hum.MaxHealth, 1), 0, 1)
                objs.HealthLbl.TextColor3 = Color3.fromRGB(
                    math.floor((1-pct)*255),
                    math.floor(pct*220),
                    60
                )
            else
                objs.HealthLbl.Visible = false
            end

            if show and Flags.ESPDistance then
                objs.DistLbl.Visible = true
                objs.DistLbl.Text = ("[%d studs]"):format(math.floor(dist))
            else
                objs.DistLbl.Visible = false
            end

            objs.Gui.Enabled = show and (Flags.ESPName or Flags.ESPHealth or Flags.ESPDistance)

            if Flags.ESPBox then
                objs.Highlight.Enabled = show
                objs.Highlight.OutlineColor = Flags.ESPColor
                if Flags.Chams then
                    objs.Highlight.FillTransparency = 0.5
                    objs.Highlight.FillColor = Flags.ChamsColor
                else
                    objs.Highlight.FillTransparency = 1
                end
            else
                objs.Highlight.Enabled = false
            end

            if Flags.ESPTracers and show then
                local screenPos, onScreen = Camera:WorldToViewportPoint(root.Position)
                if onScreen and DrawingOK and Drawing and Drawing.new then
                    local line = tracerLines[zombie]
                    if not line then
                        line = Drawing.new("Line")
                        line.Thickness = 1
                        line.Transparency = 1
                        tracerLines[zombie] = line
                    end
                    local vp = Camera.ViewportSize
                    line.From = Vector2.new(vp.X/2, vp.Y)
                    line.To   = Vector2.new(screenPos.X, screenPos.Y)
                    line.Color   = Flags.ESPColor
                    line.Visible = true
                else
                    clearTracer(zombie)
                end
            else
                clearTracer(zombie)
            end
        end
    end
end

local origMultipliers = {}
local function applyCombatMods()
    local wd = getCurrentWeaponData()
    if not wd or not wd.WeaponMultipliers then return end
    local wn = wd.WeaponName

    if not origMultipliers[wn] then
        origMultipliers[wn] = {}
        for k, v in pairs(wd.WeaponMultipliers) do
            origMultipliers[wn][k] = v
        end
    end

    local orig = origMultipliers[wn]

    if Flags.NoRecoil then
        wd.WeaponMultipliers.Recoil = 0
    else
        wd.WeaponMultipliers.Recoil = orig.Recoil or wd.WeaponMultipliers.Recoil
    end

    if Flags.NoSpread then
        wd.WeaponMultipliers["Hipfire Spread"] = 0
        local wm = getWeaponManager()
        if wm then
            wm.TotalSpread = 0
            wm.Spread = 0
            if wm.SpreadPosition and wm.SpreadPosition.Position then
                wm.SpreadPosition.Position = Vector3.new(0,0,0)
                wm.SpreadPosition.Target = Vector3.new(0,0,0)
            end
        end
    else
        wd.WeaponMultipliers["Hipfire Spread"] = orig["Hipfire Spread"] or wd.WeaponMultipliers["Hipfire Spread"]
    end

    if Flags.RapidFire then
        wd.WeaponMultipliers["Fire Rate"] = Flags.RapidFireRate
    else
        wd.WeaponMultipliers["Fire Rate"] = orig["Fire Rate"] or wd.WeaponMultipliers["Fire Rate"]
    end

    local wm = getWeaponManager()
    if wm and Flags.NoRecoil then
        wm.RecoilPosition = Vector3.new()
        wm.RecoilRotation = Vector3.new()
        if wm.GunRecoilRotation and wm.GunRecoilRotation.Position then
            wm.GunRecoilRotation.Position = Vector3.new()
            wm.GunRecoilRotation.Target   = Vector3.new()
        end
        if wm.GunRecoilPosition and wm.GunRecoilPosition.Position then
            wm.GunRecoilPosition.Position = Vector3.new()
            wm.GunRecoilPosition.Target   = Vector3.new()
        end
        if wm.GunPunchCameraRotationX then wm.GunPunchCameraRotationX.Position = 0; wm.GunPunchCameraRotationX.Target = 0 end
        if wm.GunPunchCameraRotationY then wm.GunPunchCameraRotationY.Position = 0; wm.GunPunchCameraRotationY.Target = 0 end
        if wm.GunPunchCameraRotationZ then wm.GunPunchCameraRotationZ.Position = 0; wm.GunPunchCameraRotationZ.Target = 0 end
    end

    if wm and Flags.NoSway then
        if wm.MouseSwayRotation and wm.MouseSwayRotation.Position then
            wm.MouseSwayRotation.Position = Vector3.new()
            wm.MouseSwayRotation.Target   = Vector3.new()
        end
    end
end

local AimCurrentTarget = nil
local AimLastTick = 0
local mousemoverel = mousemoverel

local function aimAtPart(part)
    if not (part and part.Parent) then return end
    local target = predictPart(part)
    local sm = math.clamp(1 - Flags.AimbotSmoothness, 0.02, 1)
    if Flags.AimbotMode == "Mouse" and mousemoverel then
        local sp = Camera:WorldToViewportPoint(target)
        local mp = UserInputService:GetMouseLocation()
        mousemoverel((sp.X - mp.X) * sm, (sp.Y - mp.Y) * sm)
    else
        local cur = Camera.CFrame
        Camera.CFrame = cur:Lerp(CFrame.new(cur.Position, target), sm)
    end
end

local function runAimbot()
    if not Flags.Aimbot then
        AimCurrentTarget = nil
        return
    end
    local now = tick()
    local rate = math.max(Flags.AimbotRefresh, 1)
    if now - AimLastTick < 1 / rate then return end
    AimLastTick = now

    local target
    if Flags.AimbotSticky and AimCurrentTarget and AimCurrentTarget.Parent then
        target = AimCurrentTarget
    else
        target = getAimbotTarget()
        AimCurrentTarget = target
    end
    if target then aimAtPart(target) end
end

