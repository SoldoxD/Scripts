local function settleOnGround()
    if not alive() then return false end
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = {char}
    params.IgnoreWater = true
    params.RespectCanCollide = true
    local result = workspace:Raycast(hrp.Position + Vector3.new(0, 8, 0), Vector3.new(0, -160, 0), params)
    if not result then return false end
    local clearance = hum.HipHeight + (hrp.Size.Y / 2) + 0.1
    local rotation = hrp.CFrame.Rotation
    anchorAt(CFrame.new(result.Position + Vector3.new(0, clearance, 0)) * rotation)
    pcall(function() hum.Sit = false end)
    pcall(function() hum:ChangeState(Enum.HumanoidStateType.GettingUp) end)
    task.wait(0.15)
    return true
end

local function isMounted()
    return char and (char:GetAttribute("MachineStandingMount") == true
        or char:GetAttribute("MachineScaleFrozen") == true
