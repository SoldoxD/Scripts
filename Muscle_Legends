local function machineOptionsForMode()
    local mode = State.FarmMode
    local keys = {}
    if mode == "Strength" or mode == "Agility" or mode == "Durability" then
        keys[GAIN_KEY[mode]] = true
    else
        for _, key in pairs(GAIN_KEY) do keys[key] = true end
    end
    local options, seen = {"Auto (Best)"}, { ["Auto (Best)"] = true }
    local function consider(inst, specialKey)
        local supported = specialKey and keys[specialKey]
        if not supported then
            for key in pairs(keys) do
                if inst:FindFirstChild(key) then supported = true break end
            end
        end
        if supported and sourceAreaAllowed(inst) and not seen[inst.Name] then
            seen[inst.Name] = true
            options[#options + 1] = inst.Name
        end
    end
    for _, machine in ipairs(machinesFolder:GetChildren()) do consider(machine) end
    for _, treadmill in ipairs(treadmillsFolder:GetChildren()) do consider(treadmill, "agilityGain") end
    table.sort(options, function(a, b)
        if a == b then return false end
        if a == "Auto (Best)" then return true end
        if b == "Auto (Best)" then return false end
        return a < b
    end)
    return options
end

local function toolOptionsForMode()
    local mode = State.FarmMode
    local keys = {}
    if mode == "Strength" or mode == "Agility" or mode == "Durability" then
        keys[GAIN_KEY[mode]] = true
    else
        for _, key in pairs(GAIN_KEY) do keys[key] = true end
    end
    local options, seen = {"Auto (Best)"}, { ["Auto (Best)"] = true }
    for _, tool in ipairs(inventoryTrainingTools()) do
        local stats = TOOL_STATS[tool.Name]
        local supported = false
        for key in pairs(keys) do
            local gain = tool:FindFirstChild(key)
            if (gain and type(gain.Value) == "number") or (stats and stats[key]) then
                supported = true
                break
            end
        end
        if supported and not seen[tool.Name] then
            seen[tool.Name] = true
            options[#options + 1] = tool.Name
        end
    end
    table.sort(options, function(a, b)
        if a == b then return false end
        if a == "Auto (Best)" then return true end
        if b == "Auto (Best)" then return false end
        return a < b
    end)
    return options
end

