    end
    return deleted
end

local EMPTY_FUSE_SLOTS = {false, false, false, false}

local function fuseGroups(selection)
    local grouped = {}
    local folder = LocalPlayer:FindFirstChild("petsFolder")
    if not folder then return {} end
    local equipped = equippedSet()
    for _, rarityFolder in ipairs(folder:GetChildren()) do
        for _, pet in ipairs(rarityFolder:GetChildren()) do
            if pet:IsA("StringValue") and selectedName(selection, pet.Name) and not equipped[pet] then
                local evolved = pet:FindFirstChild("evolved") ~= nil
                local key = pet.Name .. (evolved and "\1evolved" or "\1normal")
                local group = grouped[key]
                if not group then
                    group = {name = pet.Name, evolved = evolved, pets = {}}
                    grouped[key] = group
                end
                group.pets[#group.pets + 1] = pet
            end
        end
    end
    local groups = {}
    for _, group in pairs(grouped) do
        if #group.pets >= 4 then groups[#groups + 1] = group end
    end
    table.sort(groups, function(a, b)
        if a.name ~= b.name then return a.name < b.name end
        if a.evolved ~= b.evolved then return not a.evolved end
        return false
    end)
    return groups
end

local function atPetMachine(callback)
    local savedMode = State.FarmMode
    local wasFarming = savedMode ~= "Off"
    local savedCFrame = alive() and hrp.CFrame or nil
    Runtime.PetFuseBusy = true
    if wasFarming then
        Runtime.FarmToken = Runtime.FarmToken + 1
        Runtime.ActiveSourceKind = nil
        pcall(leaveMachine)
        task.wait(0.2)
    end

    local ok, result = pcall(function()
        local machine = workspace:FindFirstChild("PetMachine")
        local prompt = machine and machine:FindFirstChild("promptPart", true)
        if not prompt or not prompt:IsA("BasePart") or not alive() then return 0 end
        local lift = prompt.Size.Y / 2 + hrp.Size.Y / 2 + 2
        anchorAt(prompt.CFrame * CFrame.new(0, lift, 0))
        task.wait(0.25)
        return callback()
    end)

    if savedCFrame and alive() then
        anchorAt(savedCFrame)
        task.wait(0.15)
    end
    Runtime.PetFuseBusy = false
    if wasFarming and State.FarmMode == savedMode then startFarm() end
    if not ok then return 0 end
    return result or 0
end

local function fuseSelectedPets()
    local selected = State.FusePetNames
    if type(selected) ~= "table" then return 0 end

    -- The craft machine has one server-side timed slot. Query/claim that slot
    -- with empty inputs; the four input instances only belong to craftPets.
    local current = invoke(Remotes.PetCraft, "getFuse", EMPTY_FUSE_SLOTS)
    if type(current) ~= "table" then
        Runtime.FuseStatus = "Could not read fuse state"
        return 0
    end
    if current.Reason == "rateLimited" then
        Runtime.FuseStatus = "Fuse remote cooling down"
        return 0
    end
    if current.Fuse then
        local remaining = math.max(tonumber(current.Fuse.RemainingTime) or 0, 0)
        Runtime.FuseRemaining = remaining
        if remaining > 0 then
            Runtime.FuseStatus = ("Waiting %dm %02ds for %s"):format(
                math.floor(remaining / 60), math.floor(remaining % 60),
                tostring(current.Fuse.PetName or "fuse reward"))
            return 0
        end
        return atPetMachine(function()
            local claimed = invoke(Remotes.PetCraft, "claimFuse", EMPTY_FUSE_SLOTS)
            if type(claimed) == "table" and claimed.Ok then
                Runtime.FuseRemaining = 0
                Runtime.FuseStatus = "Reward claimed; preparing next selected group"
                return 1
            end
            Runtime.FuseStatus = "Claim waiting: " .. tostring(type(claimed) == "table" and claimed.Reason or "unknown")
            return 0
        end)
    end

    local groups = fuseGroups(selected)
    local group = groups[1]
    if not group then
        Runtime.FuseRemaining = 0
        Runtime.FuseStatus = "Need 4 matching unequipped copies"
        return 0
    end
    local batch = {group.pets[1], group.pets[2], group.pets[3], group.pets[4]}
    return atPetMachine(function()
        local crafted = invoke(Remotes.PetCraft, "craftPets", batch)
        if type(crafted) == "table" and crafted.Ok then
            local remaining = crafted.Fuse and math.max(tonumber(crafted.Fuse.RemainingTime) or 0, 0) or 0
            Runtime.FuseRemaining = remaining
            Runtime.FuseStatus = ("Started %s%s fuse (%dm %02ds)"):format(
                group.evolved and "evolved " or "", group.name,
                math.floor(remaining / 60), math.floor(remaining % 60))
            Runtime.Evolved = Runtime.Evolved + 1
            return 1
        end
        Runtime.FuseStatus = "Craft failed: " .. tostring(type(crafted) == "table" and crafted.Reason or "unknown")
        return 0
    end)
end

-- Kept for callers of the older session API; this now performs the actual
-- four-pet fusion flow instead of the unrelated five-copy evolve event.
