    local byId = {}
    for _, circle in ipairs(areaCircles:GetChildren()) do
        local nameValue = circle:FindFirstChild("areaName")
        local amountValue = circle:FindFirstChild("requiredAmount")
        local rawName = nameValue and tostring(nameValue.Value) or nil
        local id = rawName == "Muscle King" and "Muscle King Gym" or rawName
