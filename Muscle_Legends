local function normalizeName(value)
    return tostring(value or ""):lower():gsub("[^%w]", "")
end

local function numericValue(value)
    if type(value) == "number" then return value end
    if typeof(value) == "Instance" then
        if value:IsA("IntValue") or value:IsA("NumberValue") then return value.Value end
    end
    return nil
end

local function rebirthRequirement(inst)
    if not inst then return nil end
    for name, value in pairs(inst:GetAttributes()) do
        if normalizeName(name):find("rebirth", 1, true) then
            local number = numericValue(value)
            if number then return number end
        end
    end
    for _, child in ipairs(inst:GetDescendants()) do
        if normalizeName(child.Name):find("rebirth", 1, true) then
            local number = numericValue(child)
            if number then return number end
        end
    end
    return nil
end

local function instancePosition(inst)
    if not inst then return nil end
    if inst:IsA("BasePart") then return inst.Position end
    if inst:IsA("Model") and inst.PrimaryPart then return inst.PrimaryPart.Position end
    local part = inst:FindFirstChildWhichIsA("BasePart", true)
    return part and part.Position or nil
end

local function areaDestinationPad(area)
    if not area or not areaTeleportParts then return nil end
    for _, part in ipairs(areaTeleportParts:GetChildren()) do
        local partName = normalizeName(part.Name)
        for _, alias in ipairs(area.aliases) do
            if partName:find("to" .. alias, 1, true) and part:IsA("BasePart") then
                return part
            end
        end
    end
    return nil
end

local function areaForInstance(inst)
    if not inst then return nil end
    local name = normalizeName(inst.Name)
    for i = #AREA_DEFS, 1, -1 do
        local area = AREA_DEFS[i]
        for _, alias in ipairs(area.aliases) do
            if name:find(alias, 1, true) then return area end
        end
    end
    local required = rebirthRequirement(inst)
    if required ~= nil then
        local matched, matches
        matches = 0
        for _, area in ipairs(AREA_DEFS) do
            if area.required == required then
                matched = area
                matches = matches + 1
            end
        end
        if matches == 1 then return matched end
    end
    -- Destination pads live inside their actual farm regions. Only accept a
    -- spatial match within that region; choosing the globally nearest pad made
    -- unrelated/hidden machines look like Beach machines.
    local position = instancePosition(inst)
    local nearest, nearestDistance
    if position then
        for _, area in ipairs(AREA_DEFS) do
            local pad = areaDestinationPad(area)
            if pad then
                local distance = (position - pad.Position).Magnitude
                if not nearestDistance or distance < nearestDistance then
                    nearest, nearestDistance = area, distance
                end
            end
        end
    end
    if nearest and nearestDistance <= 1600 then return nearest end
    return nil
end

