spawnTask(function()
    local lastSignature = ""
    while running() do
        local names = inventoryPetNames()
        local signature = table.concat(names, "\0")
        if signature ~= lastSignature then
            lastSignature = signature
            if #names == 0 then names = {"No pets found"} end
            local valid = {}
            for _, name in ipairs(names) do
                if name ~= "No pets found" and State.DeletePetNames[name] then valid[name] = true end
            end
            petDeleteDropdown.UpdateOptions(names, true)
            petDeleteDropdown.SetValue(valid)
            valid = {}
            for _, name in ipairs(names) do
                if name ~= "No pets found" and State.FusePetNames[name] then valid[name] = true end
            end
            petFuseDropdown.UpdateOptions(names, true)
            petFuseDropdown.SetValue(valid)
        end
        if fuseStatusLabel then fuseStatusLabel.SetText("Fuse status: " .. Runtime.FuseStatus) end
        task.wait(2)
    end
end)

