local function selectedToolArea()
    local best
    for _, area in ipairs(AREA_DEFS) do
        if areaSelected(area) and area.required <= Rebirths.Value
            and (not best or area.required >= best.required) then
            best = area
        end
    end
    return best
end

local function insideRecordedArea(area)
    return area and alive() and Runtime.CurrentArea == area.id and Runtime.AreaAnchor ~= nil
        and (hrp.Position - Runtime.AreaAnchor.Position).Magnitude <= 1000
end

travelToArea = function(area, instant)
    if not area or not alive() then return false end
    if insideRecordedArea(area) then
        if area.id == "Muscle King Gym" then Runtime.KingGymAnchor = Runtime.KingGymAnchor or hrp.CFrame end
        return true
    end
    Runtime.CurrentArea = nil
    if isMounted() and not leaveMachine() then return false end
    Runtime.AreaTravelBusy = true
    Runtime.PendingArea = area
    Runtime.PendingAreaUntil = os.clock() + 15
    Runtime.Status = "Travelling to " .. area.id
    local arrived = false
    local originalCharacter = char
    local before = hrp.Position

    local travelCircle = area.circle
    local nearestCircleDistance
    for _, circle in ipairs(area.circles or {}) do
        local position = instancePosition(circle)
        if position then
            local distance = (hrp.Position - position).Magnitude
            if not nearestCircleDistance or distance < nearestCircleDistance then
                travelCircle, nearestCircleDistance = circle, distance
            end
        end
    end
    if travelCircle and not instant then
        invoke(Remotes.Area, "travelToArea", travelCircle)
        local deadline = os.clock() + 2
        while running() and os.clock() < deadline do
            if alive() and (char ~= originalCharacter or (hrp.Position - before).Magnitude > 50) then
                arrived = true
                break
            end
            beat()
            task.wait(0.1)
        end
    end

    if not arrived then
        local pad = findAreaPad(area)
        if not pad then
            Runtime.AreaTravelBusy = false
            Runtime.PendingArea = nil
            return false
        end
        local deadline = os.clock() + 5
        while running() and not alive() and os.clock() < deadline do task.wait(0.1) end
        if alive() then
            local lift = (pad.Size.Y / 2) + (hrp.Size.Y / 2) + 0.15
            anchorAt(pad.CFrame * CFrame.new(0, lift, 0))
            beat()
            task.wait(0.2)
            arrived = true
        end
    end

    if arrived then
        task.wait(0.25)
        settleOnGround()
        Runtime.CurrentArea = area.id
        Runtime.AreaAnchor = hrp.CFrame
        if area.id == "Muscle King Gym" then Runtime.KingGymAnchor = hrp.CFrame end
        if State.FarmMode == "Off" then Runtime.Status = "At " .. area.id end
        Runtime.PendingAreaUntil = os.clock() + 3
        task.delay(3, function()
            if Runtime.PendingArea == area and os.clock() >= Runtime.PendingAreaUntil then
                Runtime.PendingArea = nil
            end
        end)
    else
        Runtime.PendingArea = nil
    end
    Runtime.AreaTravelBusy = false
    return arrived
end

local teleportToKingsGym

local function prepareToolArea()
    local area = selectedToolArea()
    if area then return travelToArea(area) end
    if State.AlwaysKingsGym then return teleportToKingsGym and teleportToKingsGym() end
