    local aliases = {
        Beach = {"beach"},
        ["Tiny Island"] = {"tinyisland", "tiny"},
        ["Frost Gym"] = {"frost"},
        ["Mythical Gym"] = {"mythical", "mystic"},
        ["Eternal Gym"] = {"eternal", "inferno"},
        ["Legends Gym"] = {"legends", "legend"},
        ["Jungle Gym"] = {"jungle", "ancient"},
        ["Industrial Gym"] = {"industrial"},
        ["Muscle King Gym"] = {"muscleking", "kinggym", "king"},
