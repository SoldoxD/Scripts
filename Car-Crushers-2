    return p and p.Value or 0
end

local function getScraps()
    local s = LocalPlayer:FindFirstChild("Scraps")
    return s and s.Value or 0
end

local function getMaxScrapsFor(carName)
    local v = VehicleInformation:FindFirstChild(carName)
    if not v then return 0 end
    local cust = v:FindFirstChild("Customization")
    local max  = cust and cust:FindFirstChild("MaxScraps")
    return max and max.Value or 0
end

local customsCache, customsCacheTime = nil, 0
local function refreshCustoms(force)
    if force or not customsCache or os.clock() - customsCacheTime > 5 then
        local ok, _t3, _t2, _t5, t6 = pcall(function()
            return rF:WaitForChild("GetData"):InvokeServer("Essentials")
        end)
        if ok and type(t6) == "table" then
            customsCache, customsCacheTime = t6, os.clock()
        end
    end
    return customsCache or {}
end

local function isAlreadyPlatinum(carName)
    local data = refreshCustoms()
    local entry = data[carName]
    if not entry then return false end
    local bp = entry.BodyPaint
    local paint = bp and bp.Paint
    return paint and paint.Material == "Platinum" or false
end

local function applyPlatinumPaint(carName, force)
    if not isRealCar(carName) then return false end
    if not force and paintedCars[carName] then return false end

    if isAlreadyPlatinum(carName) then
        paintedCars[carName] = true
        return false
    end

    local maxForCar = getMaxScrapsFor(carName)
    local available = getScraps()
    local scraps = math.min(maxForCar > 0 and maxForCar or available, available)
    if maxForCar > 0 and scraps == 0 then
        scraps = maxForCar
    end

    local payload = {
        BodyPaint = { Paint = { Material = "Platinum" } },
        Scraps    = scraps,
    }

    local ok = pcall(function() SaveCustoms:FireServer(payload, carName) end)
    if ok then
        paintedCars[carName] = true
        local data = customsCache or {}
        data[carName] = data[carName] or {}
        data[carName].BodyPaint = { Paint = { Material = "Platinum" } }
        customsCache = data
        status(("Painted %s (Platinum, %d scraps)"):format(carName, scraps))
    end
    return ok
end

local ownedCache, ownedCacheTime = {}, 0
local function refreshOwned(force)
    if force or os.clock() - ownedCacheTime > 2 then
        local ok, list = pcall(function() return GetOwnedFn:InvokeServer("Cars") end)
        if ok and type(list) == "table" then
            ownedCache, ownedCacheTime = list, os.clock()
        end
    end
    return ownedCache
end

local function getBestOwned()
    local best, bestIdx = nil, 0
    for _, name in ipairs(refreshOwned()) do
        local idx = table.find(VehicleOrder, name)
        if idx and idx > bestIdx then best, bestIdx = name, idx end
    end
    return best
end

local function autoBuyPlatina()
    local platina = getPlatina()
    if platina <= 0 then return end

    local ownedSet = {}
    for _, n in ipairs(refreshOwned()) do ownedSet[n] = true end

    local cands = {}
    for _, name in ipairs(VehicleOrder) do
        if not ownedSet[name] then
            local v = VehicleInformation:FindFirstChild(name)
            if v then
                local pp = v:FindFirstChild("PlatinaPrice")
                if pp and pp.Value > 0 then
                    table.insert(cands, { name = name, price = pp.Value })
                end
            end
        end
    end
    table.sort(cands, function(a, b) return a.price < b.price end)

    local bought = 0
    for _, c in ipairs(cands) do
        if platina < c.price then break end
        local ok, success = pcall(function() return PurchPlatinaFn:InvokeServer(c.name) end)
        if ok and success then
            platina = platina - c.price
            bought = bought + 1
        end
    end
    if bought > 0 then
        status(("Bought %d platina car(s)"):format(bought))
        refreshOwned(true)
    end
end

local function getMyVehicleModel()
    local cc = Workspace:FindFirstChild("CarCollection")
    return cc and cc:FindFirstChild(LocalPlayer.Name)
end

local function isCarBroken(model)
    model = model or getMyVehicleModel()
    if not model then return true end

    if model:GetAttribute("Destroyed") == true then return true end
    if model:GetAttribute("Crushed")   == true then return true end

    local car  = model:FindFirstChild("Car")
    local body = car and car:FindFirstChild("Body")
    if body then
        local seat
        for _, child in ipairs(body:GetChildren()) do
            if child:IsA("VehicleSeat") then
                seat = child
                break
            end
        end
        if seat and seat.Name == "Marked" then return true end
    end

    return false
end

local function isCarAlive()
    local m = getMyVehicleModel()
    if not m or not m.PrimaryPart then return false end
    if isCarBroken(m) then return false end
    if VehicleManager and VehicleManager.IsDriving then
        local ok, driving = pcall(function() return VehicleManager:IsDriving() end)
        if ok and not driving then return false end
    end
    return true
end

local function getDesiredCar()
    local m = State.ManualCar
    local goodOverride =
        type(m) == "string"
        and m ~= ""
        and m:sub(1, 1) ~= "("
        and table.find(VehicleOrder, m) ~= nil
    if goodOverride then return m end

    local owned = refreshOwned()
    local best, bestIdx = nil, 0
    for _, name in ipairs(owned) do
        if type(name) == "string"
           and name ~= ""
           and name:sub(1, 1) ~= "(" then
            local idx = table.find(VehicleOrder, name)
            if idx and idx > bestIdx then
                best, bestIdx = name, idx
            end
        end
    end
    return best
end

local function spawnCooldownRemaining()
    if not VehicleSpawning or not TimeKeeper then return 0 end
    local ok, endTime = pcall(VehicleSpawning.GetSpawnCooldownEndTime, "Dealership")
    if not ok or not endTime then return 0 end
    local now = TimeKeeper.GetTime()
    local remaining = endTime - now
    return remaining > 0 and remaining or 0
end
local function isValidCarNameInline(n)
    return type(n) == "string"
        and n ~= ""
        and n:sub(1, 1) ~= "("
        and table.find(VehicleOrder, n) ~= nil
end

local function fireSpawnRemoteSafe(name)
    if not isValidCarNameInline(name) then
        warn("[CC2-AutoFarm] BLOCKED spawn remote with bad name: " .. tostring(name))
        return false
    end
    SpawnRemote:FireServer("Dealership", name, true)
    return true
end

local function spawnCar(name)
    if not isValidCarNameInline(name) then
        warn("[CC2-AutoFarm] spawnCar refused: not a real car name: " .. tostring(name))
        local fallback
        for _, n in ipairs(refreshOwned()) do
            if isValidCarNameInline(n) then
                local idx = table.find(VehicleOrder, n)
                if idx and (not fallback or idx > (table.find(VehicleOrder, fallback) or 0)) then
                    fallback = n
                end
            end
        end
        if not fallback then return false end
        warn("[CC2-AutoFarm] auto-fallback to best owned: " .. fallback)
        name = fallback
    end
    local cd = spawnCooldownRemaining()
    if cd > 0 then
        status(("Spawn cooldown %.1fs"):format(cd))
        task.wait(cd + 0.1)
    end

    if not isValidCarNameInline(name) then
        warn("[CC2-AutoFarm] BLOCKED spawnCar after cooldown: " .. tostring(name))
        return false
    end

    if VehicleSpawning and VehicleSpawning.SpawnYield then
        local ok, res = pcall(function()
            return VehicleSpawning.SpawnYield("Dealership", name, true)
        end)
        if ok then return res ~= nil end
    end
    return fireSpawnRemoteSafe(name)
end

local function crushPulse()
    local model = getMyVehicleModel()
    if not model or not model.PrimaryPart then return false end

    local ok = pcall(function()
        model:PivotTo(model:GetPivot() + Vector3.new(0, State.PulseLift, 0))
    end)
    if not ok then return false end

    RunService.Heartbeat:Wait()

    pcall(function()
        local v = Vector3.new(0, -State.PulseSlam, 0)
        for _, p in ipairs(model:GetDescendants()) do
            if p:IsA("BasePart") and not p.Anchored then
                p.AssemblyLinearVelocity = v
            end
        end
    end)
    return true
end

local pulseCount = 0

task.spawn(function()
    while true do
        task.wait(State.PulseInterval)

        if State.AutoBuyPlatina then pcall(autoBuyPlatina) end

        if not State.AutoFarm then continue end

        local model = getMyVehicleModel()

        if model and model.PrimaryPart and not isCarBroken(model) then
            crushPulse()
            pulseCount = pulseCount + 1
            if pulseCount % 5 == 0 then
                status(("Pulsing… (%d)"):format(pulseCount))
            end
        else
            if model and isCarBroken(model) then
                status(("Car broken after %d pulses"):format(pulseCount))
            end
            pulseCount = 0

            local car = getDesiredCar()
            if not car then
                status("No owned car to spawn")
                task.wait(2)
            else
                if State.AutoPaint then pcall(applyPlatinumPaint, car, false) end

                status("Spawning " .. car)
                spawnCar(car)
                local t0 = os.clock()
                while os.clock() - t0 < 8 do
                    local m = getMyVehicleModel()
                    if m and m.PrimaryPart and not isCarBroken(m) then break end
                    task.wait(0.2)
                end
            end
        end
    end
end)

