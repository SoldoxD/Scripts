do
    local SAVE_FOLDER = "GuiLibrary_AutoSaves"
    local SAVE_PATH   = SAVE_FOLDER .. "/" .. tostring(game.PlaceId) .. ".json"

    if isfile and readfile and writefile and isfile(SAVE_PATH) then
        local ok, raw = pcall(readfile, SAVE_PATH)
        if ok and type(raw) == "string" and #raw > 0 then
            local HttpService = game:GetService("HttpService")
            local ok2, parsed = pcall(HttpService.JSONDecode, HttpService, raw)
            if ok2 and type(parsed) == "table" and type(parsed.Components) == "table" then
                local cleanedComponents = {}
                local dirty = false
                for _, entry in ipairs(parsed.Components) do
                    local id    = entry and entry.ID
                    local data  = entry and entry.Data
                    local value = data and data.Value
                    local isBadDropdown =
                        data and data.Type == "Dropdown"
                        and type(value) == "string"
                        and (value:sub(1, 1) == "(" or value == "(auto: best owned)")
                    local isOverrideEntry =
                        id == "Misc_Spawn_Override_Dropdown"
                        or id == "Misc_Override_car_name_(empty_=_best_owned)_Input"

                    if isBadDropdown or isOverrideEntry then
                        dirty = true
                    else
                        table.insert(cleanedComponents, entry)
                    end
                end
                if dirty then
                    parsed.Components = cleanedComponents
                    local ok3, encoded = pcall(HttpService.JSONEncode, HttpService, parsed)
                    if ok3 then
                        pcall(writefile, SAVE_PATH, encoded)
                    end
                end
            end
        end
    end
end

